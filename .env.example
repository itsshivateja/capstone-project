# DevMind AI Configuration

# Secret Key for JWT Authentication
SECRET_KEY=devmind-super-secure-production-jwt-key-2026

# Database Configuration
# In Docker: postgresql://devmind_user:devmind_password@localhost:5432/devmind_db
# Local SQLite Dev: sqlite:///./devmind.db
DATABASE_URL=sqlite:///./devmind.db

# Qdrant Vector DB
# In Docker: http://localhost:6333
# Local Embedded Mode (no Docker needed): Leave QDRANT_URL blank
QDRANT_URL=
QDRANT_STORAGE_PATH=./qdrant_storage

# LLM Providers (Optional - DevMind includes an internal semantic engine if keys are omitted)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
DEFAULT_MODEL=gpt-4o-mini
